from __future__ import annotations
from types import GenericAlias
from typing import Any, TypeVar, Generic, get_origin, get_args, cast
from collections.abc import Callable


__types_to_ignore__ = (Generic, object)


def _is_generic_alias(type_: Any) -> bool:
    return get_origin(type_) is not None and len(get_args(type_)) > 0


class _TypeNode:
    def __init__(self, type_: type[Any], generics: list[Any] | None) -> None:
        self._type = type_
        self._generics: list[Any] = generics or []
        self._generics_variants: dict[type[Any], _TypeNode] = {}
        self._direct_inheriters: list[type[Any]] = []

    @property
    def provider(self) -> Callable[..., Any] | None:
        return self._provider

    def __repr__(self) -> str:
        return f"_TypeNode[{self._type!r}]"


class _TypeTree:
    def __init__(self) -> None:
        self._root_types: dict[type[Any], _TypeNode] = {}
        self._type_node_map: dict[type[Any], _TypeNode] = {}

    def get_type_node(self, type_: type[Any]) -> _TypeNode | None:
        if type_ in self._type_node_map:
            return self._type_node_map[type_]
        return None

    def insert(self, type_: type[Any]) -> _TypeNode:
        if _is_generic_alias(type_):
            return self._insert_generic_alias(type_)
        else:
            return self._insert_type(type_)

    def _insert_generic_alias(self, ga: GenericAlias) -> _TypeNode:
        origin = get_origin(ga)
        args = get_args(ga)

        origin_node = self.insert(origin)
        return origin_node

    def _insert_type(self, type_: type[Any]) -> _TypeNode[Any]:
        if type_ in self._type_node_map:
            return self._type_node_map[type_]

        # will contain the type that the current type inherits from
        # and also pass to them generics, the types here are without the generics
        parents_with_generics: list[type[Any]] = []
        generic_aliases: list[Any] = []
        generics: list[type[Any]] = []

        origin_bases = cast(list[type[Any]], getattr(type_, "__orig_bases__", []))

        for origin_base in origin_bases:
            if not _is_generic_alias(origin_base):
                continue

            origin = cast(type[Any, get_origin(origin_base))

            if origin is Generic:
                generics.append(origin)
            else:
                generic_aliases.append(origin_base)
                parents_with_generics.append(origin)

        node = _TypeNode(type_, generics=generics)
        direct_parent_nodes: list[_TypeNode] = []
        last_parent_node: _TypeNode | None = None

        for cls in reversed(type_.__mro__):
            if cls in __types_to_ignore__ or cls is type_:
                continue

            if cls in self._type_node_map:
                parent_node = self._type_node_map[cls]
            else:
                parent_node = self.insert(cls)

            if cls in parents_with_generics:
                pass

            # if the current mro type doesn't inherit from the last parent type, which suppose
            # to be higher level class, it means that the last parent was our direct parent
            if last_parent_node and not issubclass(cls, last_parent_node._type):
                direct_parent_nodes.append(last_parent_node)

            last_parent_node = parent_node

        if last_parent_node and not direct_parent_nodes:
            direct_parent_nodes.append(last_parent_node)

        # if the current type doesn't inherit from any other type node
        # it means it is a parent node
        if not direct_parent_nodes:
            self._root_types[type_] = node
        else:
            for direct_parent in direct_parent_nodes:
                # add the current node as the implementor for the parent node
                direct_parent._direct_inheriters.append(node)
        self._type_node_map[type_] = node
        return node


class _TypeCompositor:
    def __init__(self) -> None:
        self._tree = _TypeTree()

    def get_type_node(self, type_: type[Any]) -> _TypeNode:
        return self._tree.insert(type_)


_compositor = _TypeCompositor()

class Container:
    def __init__(self) -> None:
        self._map: dict[_TypeNode, Callable[..., Any]] = {}

    def add_provider(self, type_: type[Any], provider: Callable[..., Any]) -> None:
        node = _compositor.get_type_node()
        self._map[node] =
